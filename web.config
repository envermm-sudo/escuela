<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
    <!-- Permitir archivos sin extensión registrada (.webp por las dudas) -->
    <staticContent>
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
        <rules>

            <!-- Regla 1: /media/* → servir directo desde disco (NO proxy a Django) -->
            <rule name="Servir media estáticamente" stopProcessing="true">
                <match url="^media/(.*)$" />
                <action type="None" />
            </rule>

            <!-- Regla 2: /static/* → servir directo desde disco (NO proxy a Django) -->
            <rule name="Servir static estáticamente" stopProcessing="true">
                <match url="^static/(.*)$" />
                <action type="None" />
            </rule>

            <!-- Regla 3: todo lo demás → proxy a Waitress -->
            <rule name="Proxy Portal Escolar" stopProcessing="true">
                <match url="(.*)" />
                <action type="Rewrite" url="http://127.0.0.1:8005/{R:1}" />
            </rule>

        </rules>
    </rewrite>

    <!-- Habilitar caché en headers para imágenes (mejor performance) -->
    <httpProtocol>
        <customHeaders>
            <add name="X-Powered-By" value="Tecnosoft" />
        </customHeaders>
    </httpProtocol>

    <!-- Permitir uploads de hasta 50 MB (varias imágenes de celular) -->
    <security>
        <requestFiltering>
            <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
    </security>

</system.webServer>
</configuration>
